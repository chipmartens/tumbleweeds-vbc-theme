{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Tumbleweeds Volleyball Club: WordPress theme demo",
    "description": "The Tumbleweeds club site as a real WordPress install: the theme from GitHub, Secure Custom Fields, all pages, coaches and news seeded, logged in as admin so you can open the editor and Club settings.",
    "author": "Chip Martens",
    "categories": ["Showcase"]
  },
  "landingPage": "/",
  "preferredVersions": { "php": "8.3", "wp": "latest" },
  "features": { "networking": true },
  "steps": [
    { "step": "login", "username": "admin", "password": "password" },
    { "step": "installPlugin", "pluginData": { "resource": "wordpress.org/plugins", "slug": "secure-custom-fields" }, "options": { "activate": true } },
    { "step": "installPlugin", "pluginData": { "resource": "wordpress.org/plugins", "slug": "classic-editor" }, "options": { "activate": true } },
    {
      "step": "installTheme",
      "themeData": { "resource": "url", "url": "https://github.com/chipmartens/tumbleweeds-vbc-theme/archive/refs/heads/main.zip?v=dcc4141" },
      "options": { "targetFolderName": "tumbleweeds-vbc", "activate": true }
    },
    { "step": "runPHP", "code": "<?php require_once '/wordpress/wp-load.php'; include '/wordpress/wp-content/themes/tumbleweeds-vbc/seed/import.php';" }
  ]
}
