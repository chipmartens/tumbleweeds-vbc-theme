{
  "_about": "Single source of truth for Tumbleweeds VBC. Feeds WordPress SCSS root, ad builder, InDesign swatches, brand guidelines. Colours sampled from the original logo and poster, then cleaned. v1 2026-10-01.",
  "color": {
    "pine-900": { "hex": "#172111", "use": "Ink. Logo mark, headlines on light, darkest text" },
    "pine-700": { "hex": "#283B27", "use": "Primary brand green. Large fields, buttons, footers" },
    "pine-500": { "hex": "#4A6247", "use": "Hover and secondary green" },
    "sage-300": { "hex": "#A9B59A", "use": "Quiet accents, dividers on dark" },
    "bark-700": { "hex": "#44301B", "use": "Wordmark brown, secondary headlines" },
    "sun-500":  { "hex": "#C8963E", "use": "Accent only. Highlights, jersey numbers, one element per layout" },
    "sand-100": { "hex": "#F3EBDF", "use": "Default light background" },
    "sand-200": { "hex": "#E7DBC8", "use": "Cards and panels on sand-100" },
    "white":    { "hex": "#FFFFFF", "use": "Text on pine" }
  },
  "type": {
    "display": { "family": "Barlow Condensed", "weights": [600, 700, 800], "case": "uppercase for headlines up to ~6 words", "source": "Google Fonts (OFL)" },
    "body":    { "family": "Barlow", "weights": [400, 500, 600], "source": "Google Fonts (OFL)" },
    "scale_px": { "xs": 13, "sm": 15, "base": 18, "lg": 22, "xl": 28, "2xl": 40, "3xl": 56, "4xl": 80, "5xl": 112 },
    "line_height": { "display": 0.95, "heading": 1.1, "body": 1.55 },
    "tracking": { "display": "0.01em", "eyebrow": "0.14em" }
  },
  "space_px": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64, "9": 96, "10": 128 },
  "radius_px": { "sm": 4, "md": 8, "lg": 16, "pill": 999 },
  "layout": { "max_width_px": 1240, "gutter_mobile_px": 16, "gutter_desktop_px": 32, "measure_ch": 68 },
  "logo_files": {
    "mark": "brand/logo/tumbleweeds-mark.svg",
    "primary_lockup": "brand/logo/tumbleweeds-lockup-stacked.svg",
    "horizontal_lockup": "brand/logo/tumbleweeds-lockup-horizontal.svg",
    "fallback_original": "source/logo-original.png"
  },
  "pairings_that_pass_wcag_aa": "pine-900 or pine-700 or bark-700 on sand-100/sand-200/white; white or sand-100 on pine-700/pine-900. sun-500 never carries body text."
}
